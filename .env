# Flask Configuration
SECRET_KEY=dev-secret-key-ai-customer-feedback-analysis-2026-super-secure
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (MySQL Community Edition)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=customer_feedback_db

# Local Ollama LLM Configuration (Free / Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Application Settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_DAYS=7
